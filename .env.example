# gremote configuration. Copy to .env and edit.

# Random secret used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
GREMOTE_SECRET_KEY=change-me-to-a-long-random-string

# Password for the dashboard login.
GREMOTE_ADMIN_PASSWORD=change-me

# SQLite database file location.
GREMOTE_DATABASE_PATH=gremote.db

# How long a login session lasts, in seconds (default: 7 days).
GREMOTE_SESSION_TTL_SECONDS=604800
