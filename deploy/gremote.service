[Unit]
Description=gremote home-network remote control dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/gremote
EnvironmentFile=/etc/gremote.env
ExecStart=/opt/gremote/.venv/bin/uvicorn app.main:app --host ${GREMOTE_HOST} --port ${GREMOTE_PORT}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
